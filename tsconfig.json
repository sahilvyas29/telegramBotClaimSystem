{
    "compilerOptions": {
      "target": "ES6",                         
      "module": "commonjs",                    
      "rootDir": "./src",                      
      "outDir": "./dist",                      
      "esModuleInterop": true,        
      "resolveJsonModule": true,         
      "forceConsistentCasingInFileNames": true,
      "strict": true,                          
      "skipLibCheck": true                     
    }
  }
  